{
  "name": "ten98-monitor",
  "version": "0.1.0-preview.10",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000 --strictPort",
    "check:architecture": "node node_modules/@ten98/runtime/check.mjs .",
    "build": "pnpm check:architecture && vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm check:architecture && node --test --test-concurrency=2 tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env tests/integration.ts",
    "setup:local": "node src/server/cli.ts setup",
    "migrate": "node --env-file-if-exists=.env src/server/cli.ts migrate",
    "worker": "node --env-file-if-exists=.env src/server/cli.ts worker",
    "diagnose": "node --env-file-if-exists=.env src/server/cli.ts diagnose",
    "check:plan": "node scripts/check-plan.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@ten98/ui": "file:vendor/ten98-ui-0.3.16.tgz",
    "@ten98/runtime": "file:vendor/ten98-runtime-0.1.1.tgz",
    "better-auth": "1.7.7",
    "detect-browser": "5.3.0",
    "drizzle-orm": "0.45.2",
    "mmdb-lib": "3.0.3",
    "nodemailer": "10.1.1",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "pg-boss": "12.37.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "ua-parser-js": "1.0.41",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ua-parser-js": "0.7.39",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
