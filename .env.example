# ten98-monitor — local development environment template.
#
# Generate a real .env with:
#   pnpm run setup:local
# It writes 32-byte hex values for the three secrets below and refuses to
# overwrite an existing .env. NEVER use the placeholder values as-is.
# There is no public/default admin password: you choose owner credentials in
# the UI, authorized with the bootstrap token.

APP_URL=http://localhost:3000
APP_PORT=3000

POSTGRES_PASSWORD=replace-with-generated-random-value
AUTH_SECRET=replace-with-generated-random-value
BOOTSTRAP_TOKEN=replace-with-generated-random-value

# Example for local, non-Compose development against a host DB only.
# Placeholders, not a working secret. Compose injects its own internal
# DATABASE_URL (postgres:5432) and ARTIFACT_DIR (/data/artifacts).
DATABASE_URL=postgresql://ten98:replace-with-generated-random-value@localhost:5432/ten98
ARTIFACT_DIR=./data/artifacts
